APP_NAME="Activity Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
# Untuk SQLite baseline, cukup buat file kosong: database/database.sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite (opsional, default sudah otomatis)

LOG_CHANNEL=stack
LOG_LEVEL=debug
